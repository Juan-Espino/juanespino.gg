# Since the ".env" file is gitignored, you can use the ".env.example" file to
# build a new ".env" file when you clone the repo. Keep this file up-to-date
# when you add new variables to `.env`.

# This file will be committed to version control, so make sure not to have any
# secrets in it. If you are cloning this repo, create a copy of this file named
# ".env" and populate it with your secrets.

# When adding additional environment variables, the schema in "/src/env.js"
# should be updated accordingly.

# Local example may use the Supabase pooler or direct database URL.
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@[YOUR-SUPABASE-HOST]:6543/postgres"

# Better Auth
# Generate with:
# openssl rand -base64 32
# or use any secure 32+ character random string.
BETTER_AUTH_SECRET="replace-with-a-secure-random-secret"

# Better Auth Base URL
# Local:
# BETTER_AUTH_URL="http://localhost:3000"
#
# Production:
# BETTER_AUTH_URL="https://bloggin-five.vercel.app"
BETTER_AUTH_URL="http://localhost:3000"

# GitHub OAuth
# Create these in:
# GitHub Settings > Developer settings > OAuth Apps
#
# Local callback URL:
# http://localhost:3000/api/auth/callback/github
#
# Production callback URL:
# https://bloggin-five.vercel.app/api/auth/callback/github
BETTER_AUTH_GITHUB_CLIENT_ID="replace-with-github-oauth-client-id"
BETTER_AUTH_GITHUB_CLIENT_SECRET="replace-with-github-oauth-client-secret"

# Bloggin Admin Access
# Comma-separated list of emails allowed to create/edit articles.
# Example:
# ADMIN_EMAILS="you@example.com,other-admin@example.com"
ADMIN_EMAILS="you@example.com"